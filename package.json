{
  "name": "tarih-atlasi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "expo-router/entry",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": "12.2.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:bundle": "expo export --platform android --output-dir dist-android",
    "web:export": "expo export --platform web && node scripts/places/export-web.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node tests/run.mjs",
    "etl": "node scripts/etl/cli.mjs",
    "pilot:prepare": "node scripts/pilot/cli.mjs",
    "pilot:check": "node scripts/pilot/check.mjs",
    "timeline:coverage": "node scripts/timeline-coverage.mjs",
    "ohm:collect": "node scripts/etl/collect-ohm.mjs",
    "globe:prepare": "node scripts/prepare-globe-assets.mjs",
    "test:web": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:worker && npm run globe:check && npm run basemap:check && npm run physical:check && npm run pilot:check && npm run sitelinks:check && npm run chunks:check && npm run world:check && npm run world:review:check && npm run polities:identities:check && npm run places:check && npm run people:check && npm run people:expanded:check && npm run people:ottoman:check && npm run people:global:check && npm run people:broad:check && npm run history:check && npm run format:check",
    "config:check": "expo config --type public",
    "dependencies:report": "node scripts/dependency-report.mjs",
    "environment:check": "node scripts/check-environment.mjs",
    "test:worker": "node tests/unit/worker.test.mjs",
    "globe:check": "node scripts/check-globe-assets.mjs",
    "persons:collect": "node scripts/etl/collect-persons.mjs",
    "people:prepare": "node scripts/people/prepare.mjs",
    "people:check": "node scripts/people/check.mjs",
    "people:requests:prepare": "node scripts/people/requests.mjs",
    "people:requests:collect": "node scripts/people/collect-requests.mjs",
    "people:expanded:prepare": "node scripts/people/expansion.mjs && node scripts/people/requests.mjs",
    "people:expanded:check": "node scripts/people/check-expansion.mjs",
    "sitelinks:prepare": "node scripts/sitelinks.mjs",
    "sitelinks:check": "node scripts/sitelinks.mjs --check",
    "sitelinks:collect": "node scripts/etl/collect-sitelinks.mjs",
    "chunks:prepare": "node scripts/chunks.mjs",
    "chunks:check": "node scripts/chunks.mjs --check",
    "benchmark:host": "node --expose-gc scripts/performance/host.mjs",
    "benchmark:sizes": "node scripts/performance/sizes.mjs",
    "benchmark:web": "node scripts/performance/web.mjs",
    "benchmark:android": "node scripts/performance/android.mjs",
    "qa:coverage": "node scripts/qa/coverage.mjs",
    "qa:licenses": "node scripts/qa/licenses.mjs",
    "qa:security": "node scripts/qa/security.mjs",
    "basemap:prepare": "node scripts/prepare-detail-land.mjs",
    "data:download": "node scripts/map-sources.mjs",
    "places:download": "node scripts/places/download.mjs",
    "places:prepare": "node scripts/places/prepare.mjs",
    "places:check": "node scripts/places/check.mjs",
    "basemap:check": "node scripts/prepare-detail-land.mjs --check",
    "web:preview": "node scripts/qa/serve-export.mjs",
    "test:web:production": "ATLAS_TEST_PRODUCTION=1 playwright test tests/web/product-flows.spec.ts tests/web/product-quality.spec.ts tests/web/sources.spec.ts tests/web/preferences.spec.ts tests/web/release-audit.spec.ts tests/web/application-review.spec.ts tests/web/discovery-content.spec.ts tests/web/modern-places.spec.ts tests/web/person-births.spec.ts tests/web/requested-people.spec.ts tests/web/ottoman-people.spec.ts tests/web/local-notes.spec.ts tests/web/broad-history.spec.ts tests/web/history-import.spec.ts",
    "physical:prepare": "node scripts/prepare-physical-detail.mjs",
    "physical:check": "node scripts/prepare-physical-detail.mjs --check",
    "polities:check-source": "node scripts/pilot/check-polity-source.mjs",
    "world:prepare": "node scripts/world/prepare.mjs",
    "world:check": "node scripts/world/check.mjs",
    "world:source-check": "node scripts/world/prepare.mjs --check",
    "world:review:prepare": "node scripts/world/review-countries.mjs",
    "world:review:check": "node scripts/world/check-country-review.mjs",
    "world:audit-2000": "node scripts/world/audit-2000.mjs",
    "world:audit": "node scripts/world/audit-global.mjs",
    "world:audit:download": "node scripts/world/download-audit-sources.mjs",
    "cshapes:inspect": "node scripts/inspect-cshapes.mjs",
    "polities:identities:prepare": "node scripts/polity-identities.mjs",
    "polities:identities:check": "node scripts/check-polity-identities.mjs",
    "qa:map": "node scripts/qa/map-scene.mjs",
    "people:ottoman:prepare": "node scripts/people/ottoman.mjs && node scripts/people/requests.mjs",
    "people:ottoman:check": "node scripts/people/check-ottoman.mjs",
    "people:global:prepare": "node scripts/people/global.mjs && node scripts/people/requests.mjs",
    "people:global:check": "node scripts/people/global.mjs --check",
    "qa:people-visibility": "node scripts/qa/people-visibility.mjs",
    "people:broad:prepare": "node scripts/people/broad.mjs && node scripts/people/requests.mjs",
    "people:broad:check": "node scripts/people/broad.mjs --check",
    "history:collect": "node scripts/history/collect.mjs",
    "history:audit": "node scripts/history/import.mjs --audit",
    "history:prepare": "node scripts/history/import.mjs && node scripts/people/requests.mjs && prettier --write src/history/generated/assets.ts src/history/generated/dom.ts",
    "history:check": "node scripts/history/check.mjs",
    "release:assets": "npm run globe:check && npm run basemap:check && npm run physical:check && npm run pilot:check && npm run sitelinks:check && npm run chunks:check && npm run world:check && npm run world:review:check && npm run polities:identities:check && npm run places:check && npm run people:check && npm run people:expanded:check && npm run people:ottoman:check && npm run people:global:check && npm run people:broad:check && npm run history:check",
    "release:stage": "node scripts/distribution/stage.mjs",
    "release:verify": "node scripts/distribution/verify.mjs .release/web",
    "release:source": "node scripts/distribution/source.mjs",
    "web:serve": "node scripts/distribution/server.mjs",
    "release:pack": "node scripts/distribution/archive.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.17",
    "expo": "57.0.29",
    "expo-constants": "57.0.22",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.28",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "maplibre-gl": "6.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "expo-asset": "57.0.20"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "description": "Kaynakları izlenebilir, Türkçe öncelikli 3D dünya tarih atlası.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teknoloji-Filozoflari/Tarih_Atlasi.git"
  },
  "homepage": "https://github.com/Teknoloji-Filozoflari/Tarih_Atlasi#readme",
  "bugs": {
    "url": "https://github.com/Teknoloji-Filozoflari/Tarih_Atlasi/issues"
  }
}
